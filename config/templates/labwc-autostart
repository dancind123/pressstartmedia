# Press Start Media display management.
#
# Standard players use the generic display manager to keep the kiosk
# output at 1920x1080@60 Hz and apply profile-controlled rotation.
#
# The Downstairs Bar uses its dedicated dual-display keeper instead,
# so the generic display manager must not run for that profile.
(
    PLAYER_CONFIG="/home/media/PressStart/config/player.conf"
    PLAYER_PROFILE=""

    if [ -f "$PLAYER_CONFIG" ]; then
        PLAYER_PROFILE="$(
            awk -F= '
                $1 == "PLAYER_PROFILE" {
                    value=$2
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                    gsub(/^"|"$/, "", value)
                    print value
                    exit
                }
            ' "$PLAYER_CONFIG"
        )"
    fi

    if [ "$PLAYER_PROFILE" != "downstairs_bar" ]; then
        cd /home/media/PressStart/app || exit 1
        /usr/bin/python3 -m pressstart_media.display_manager
    fi
) &

# Press Start Media kiosk cursor handling.
# Wait for the graphical session, then invoke the Labwc cursor-hiding keybind.
(
    sleep 3
    /usr/bin/wtype -M alt -M logo -P h -m logo -m alt
) &

# Press Start Media kiosk desktop.
# Remove the Raspberry Pi desktop panel after the system session starts it.
(
    sleep 2
    pkill -f '/usr/bin/lwrespawn /usr/bin/wf-panel-pi' 2>/dev/null || true
    pkill -x wf-panel-pi 2>/dev/null || true
) &