<?xml version="1.0"?>
<labwc_config>
  <keyboard>
    <keybind key="A-W-h">
      <action name="HideCursor" />
      <action name="WarpCursor" x="-1" y="-1" />
    </keybind>
  </keyboard>

  <windowRules>
    <windowRule identifier="pressstart-downstairs-right">
      <action name="MoveToOutput" output="HDMI-A-1" />
      <action name="ToggleFullscreen" />
    </windowRule>

    <windowRule identifier="pressstart-downstairs-left">
      <action name="MoveToOutput" output="HDMI-A-2" />
      <action name="ToggleFullscreen" />
    </windowRule>
  </windowRules>
</labwc_config>